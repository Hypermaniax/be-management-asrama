PORT=8080
JWT_SECRET=change-me
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freaking_out?schema=public"

# OTP (stateless, time-based). Secret falls back to JWT_SECRET when unset.
OTP_SECRET=
OTP_TTL_SECONDS=300

# Email (OTP). If SMTP_HOST is empty, OTP is logged to console in non-production.
# Chosen: Gmail SMTP (send from your Gmail to any address).
#   Requires 2-Step Verification + an App Password (not the account password).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char app password>
#   MAIL_FROM=you@gmail.com
# Alternatives:
#   - console: leave SMTP_HOST empty
#   - Mailpit: SMTP_HOST=localhost SMTP_PORT=1025 (no user/pass)
#   - Resend:  SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USER=resend SMTP_PASS=re_...
#              MAIL_FROM=onboarding@resend.dev (dev, only to the account owner)
#              or no-reply@your-domain (after verifying a domain on resend.com/domains)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: bootstrap super admin via userSeeder.
# In non-production it defaults to admin@kepri.local / admin12345 when unset.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Storage (dokumen). Driver default: local (filesystem).
STORAGE_DRIVER=local
STORAGE_DIR=storage/uploads
